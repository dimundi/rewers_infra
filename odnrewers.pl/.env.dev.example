# DEV: bezwzględna ścieżka do GOTOWEGO buildu DEV lub linku do tego folderu.
# Przykład: D:/GIT/kursypanel/build-dev
# Nie wskazuj buildu z produkcyjnym adresem API.
DEV_PANEL_BUILD_DIR=
DEV_HTTP_PORT=8080

# Baza WordPressa DEV. Wpisz dwa rozne, losowe hasla.
DEV_WP_DB_NAME=wordpress_dev
DEV_WP_DB_USER=wordpress_dev
DEV_WP_DB_PASSWORD=
DEV_WP_DB_ROOT_PASSWORD=

