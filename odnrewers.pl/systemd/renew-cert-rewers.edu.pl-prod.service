[Unit]
Description=Renew PROD certificate for rewers.edu.pl and www
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=docker
Group=docker
WorkingDirectory=/home/docker/odnrewers
ExecStart=/bin/sh /home/docker/odnrewers/renew-cert-rewers.edu.pl-prod.sh
TimeoutStartSec=30min
